<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 0; align-items: flex-start; padding-top: 10px; padding-left: 10px;">
        
        <!-- Main Buttons Container -->
        <ui:VisualElement name="MainMenuContainer" style="align-items: flex-start;">
            <ui:Button text="Start Host" name="ButtonHost" style="width: 220px; height: 50px; font-size: 24px; background-color: rgb(0, 179, 255); margin-bottom: 6px; -unity-font-style: bold;"/>
            <ui:Button text="Join Game" name="ButtonJoinMenu" style="width: 220px; height: 50px; font-size: 24px; background-color: rgb(255, 128, 65); margin-bottom: 6px; -unity-font-style: bold;"/>
            <ui:Button text="Disconnect" name="ButtonDisconnect" enabled="false" style="width: 220px; height: 45px; font-size: 22px; margin-bottom: 10px;"/>
        </ui:VisualElement>

        <!-- Join Code Input Container (Hidden by default) -->
        <ui:VisualElement name="JoinCodeContainer" style="display: none; align-items: flex-start; background-color: rgba(20, 20, 20, 0.85); padding: 12px; border-radius: 8px; margin-bottom: 10px; width: 240px;">
            <ui:Label text="Enter Join Code:" style="font-size: 16px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 6px;"/>
            <ui:TextField name="InputJoinCode" style="width: 216px; height: 40px; font-size: 18px; margin-bottom: 10px;"/>
            <ui:VisualElement style="flex-direction: row; width: 100%;">
                <ui:Button text="Connect" name="ButtonClient" style="width: 120px; height: 42px; font-size: 18px; background-color: rgb(255, 128, 65); margin-right: 6px; -unity-font-style: bold;"/>
                <ui:Button text="Cancel" name="ButtonCancelJoin" style="width: 90px; height: 42px; font-size: 18px; background-color: rgb(120, 120, 120);"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Info Labels -->
        <ui:Label text="" name="LabelJoinCode" style="font-size: 22px; color: rgb(255, 220, 0); -unity-font-style: bold; margin-bottom: 4px;"/>
        <ui:Label text="" name="LabelStatus" style="font-size: 16px; color: rgb(255, 255, 255); -unity-font-style: bold;"/>

    </ui:VisualElement>
</ui:UXML>
